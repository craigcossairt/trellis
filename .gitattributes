# Shell scripts must check out with LF everywhere — CRLF breaks bash ("\r: command not found").
* text=auto
*.sh text eol=lf
brain/bin/qmd text eol=lf
.githooks/* text eol=lf

# Agent definitions are asserted LF by hooks CI. Without these lines a Windows
# checkout (core.autocrlf=true) writes them CRLF, so the same tree that passes on
# the runner fails when the check is run locally - and `---\r` also stops matching
# the opening frontmatter fence, which reads as "no frontmatter" rather than as a
# line-ending problem.
.claude/**/*.md text eol=lf
.cursor/**/*.md text eol=lf
.claude/settings.json text eol=lf

# The manifest is a DATA file a script reads, not prose. Without this, a Windows
# checkout writes it CRLF, every path in it gains a trailing carriage return,
# and nothing matches - so sync reports every file as deleted upstream. It
# passes when generated locally (LF) and fails when cloned, which is the only
# way anyone but the author ever gets it.
.trellis/manifest text eol=lf
.trellis/baseline text eol=lf
.trellis/source   text eol=lf
